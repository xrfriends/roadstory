{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://road-story.example/schemas/story.schema.json",
  "title": "Road Story Content",
  "type": "object",
  "required": [
    "id",
    "title",
    "placeId",
    "category",
    "status",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "placeId": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "IN_REVIEW",
        "VERIFIED",
        "PUBLISHED",
        "RETIRED"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "reliabilityGrade"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "organization": {
            "type": "string"
          },
          "reliabilityGrade": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E"
            ]
          }
        }
      }
    }
  }
}
# PostgreSQL JDBC 연결 주소입니다.
DATABASE_URL=jdbc:postgresql://localhost:5432/roadstory
# 로컬 개발용 Database 사용자 이름입니다.
DATABASE_USERNAME=roadstory
# 로컬 개발용 Database 비밀번호입니다. Production에서는 Secret Manager를 사용합니다.
DATABASE_PASSWORD=roadstory
# Redis Host입니다.
REDIS_HOST=localhost
# Redis Port입니다.
REDIS_PORT=6379
# local-sync에서 ROAD_STORY_DEV_ACCOUNT_A_TOKEN과 ROAD_STORY_DEV_ACCOUNT_B_TOKEN을 별도로 내보냅니다.
# 각각 openssl rand -hex 32로 생성합니다.
# 검수 음원과 JSON 메타데이터를 배치하는 디렉터리입니다.
ROAD_STORY_AUDIO_DIR=
# Route Provider 구현을 선택합니다. 로컬에서는 FAKE만 사용합니다.
ROUTE_PROVIDER_MODE=FAKE

